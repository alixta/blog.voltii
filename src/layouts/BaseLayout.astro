---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "An Australian BMW 2002 EV conversion project" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Voltii</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Voltii</a>
        <nav>
          <a href="/journal">Journal</a>
          <a href="/about">The Car</a>
          <a href="/technical">Technical</a>
          <a href="https://github.com/alixta/blog.voltii" target="_blank" rel="noopener">Source</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>Voltii — a 1973 BMW 2002tii, converted to electric, in Brisbane, Australia.</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --ink: #1a1a1a;
        --paper: #fdfdfb;
        --accent: #d64545;
        --muted: #6b6b6b;
        --border: #e5e2dc;
        --max-width: 720px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--ink);
        background: var(--paper);
        line-height: 1.65;
      }
      .wrap {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.25rem;
      }
      .site-header {
        border-bottom: 1px solid var(--border);
        padding: 1.25rem 0;
      }
      .site-header .wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .brand {
        font-weight: 800;
        font-size: 1.35rem;
        text-decoration: none;
        color: var(--ink);
        letter-spacing: -0.02em;
      }
      nav { display: flex; gap: 1.25rem; }
      nav a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.95rem;
      }
      nav a:hover { color: var(--accent); }
      main { padding: 2.5rem 0 4rem; min-height: 60vh; }
      h1, h2, h3 { line-height: 1.25; letter-spacing: -0.01em; }
      h1 { font-size: 2rem; }
      h2 { font-size: 1.4rem; margin-top: 2rem; }
      a { color: var(--accent); }
      img { max-width: 100%; height: auto; border-radius: 6px; }
      .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 0.5rem;
        margin: 1.5rem 0;
      }
      .gallery img { width: 100%; aspect-ratio: 4/3; object-fit: cover; margin: 0; }
      blockquote {
        border-left: 3px solid var(--accent);
        margin: 1.5rem 0;
        padding: 0.25rem 0 0.25rem 1rem;
        color: var(--muted);
      }
      code { background: #f0eee9; padding: 0.15em 0.4em; border-radius: 4px; font-size: 0.9em; }
      pre { background: #f0eee9; padding: 1rem; border-radius: 8px; overflow-x: auto; }
      pre code { background: none; padding: 0; }
      .site-footer {
        border-top: 1px solid var(--border);
        padding: 1.5rem 0;
        color: var(--muted);
        font-size: 0.85rem;
      }
      .post-list { list-style: none; padding: 0; }
      .post-list li {
        margin-bottom: 1.75rem;
        padding-bottom: 1.75rem;
        border-bottom: 1px solid var(--border);
      }
      .post-list li:last-child { border-bottom: none; }
      .post-list a.title {
        font-size: 1.25rem;
        font-weight: 700;
        text-decoration: none;
        color: var(--ink);
        display: block;
        margin-bottom: 0.25rem;
      }
      .post-list a.title:hover { color: var(--accent); }
      .post-meta { color: var(--muted); font-size: 0.85rem; }
      .tag {
        display: inline-block;
        font-size: 0.75rem;
        background: #f0eee9;
        color: var(--muted);
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        margin-right: 0.35rem;
      }
    </style>
  </body>
</html>
