---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Coming Soon" description="A 1973 BMW 2002tii EV conversion — build journal launching soon" minimal={true}>
  <div class="coming-soon">
    <h1>Voltii</h1>
    <p class="tagline">A 1973 BMW 2002tii, going electric.</p>
    <p>The build journal is on its way.</p>
  </div>

  <style>
    .coming-soon {
      text-align: center;
      padding: 6rem 0;
    }
    .coming-soon h1 {
      font-size: 3rem;
      margin-bottom: 0.25rem;
    }
    .tagline {
      color: var(--muted);
      font-size: 1.1rem;
      margin-bottom: 2rem;
    }
  </style>
</BaseLayout>
